# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: xkiro | openai | gemini | anthropic
# xKiro là OpenAI-compatible gateway: https://api.xkiro.com/v1
# Catalog free: https://xkiro.com/dashboard/models?price=free
LLM_PROVIDER=xkiro
LLM_MODEL=qwen/qwen3.8-omni-flash:free

# xKiro — tạo key tại https://xkiro.com/dashboard (prefix sk-xt-...)
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1

# Generation providers (chỉ điền nhánh đang dùng)
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
